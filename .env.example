# ============================================================================
# Google Sheets (optional). Pick ONE auth method. If your org blocks
# service-account keys (iam.disableServiceAccountKeyCreation), use OAuth.
# ============================================================================

# The target spreadsheet id (the long id in the sheet URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit ). Required for any
# Google Sheets writing.
SHEET_ID=

# --- Method A: OAuth (recommended; no service-account key needed) ---
# 1. GCP console -> APIs & Services -> Credentials -> Create OAuth client ID
#    -> Application type: "Desktop app" -> download the JSON here.
# 2. Enable the "Google Sheets API" for the project.
# 3. On the OAuth consent screen, add your Google account as a Test user.
# 4. Run:  npm run scout -- auth google   (opens a browser once)
GOOGLE_OAUTH_CLIENT=./oauth_client.json
GOOGLE_TOKEN_PATH=./data/google-token.json

# --- Method A (hosted): OAuth via env instead of the token file ---
# `scout auth google` prints these; set them as secrets on your host.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# --- Method B: Service account (only if your org allows key creation) ---
# GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# --- Method C: Application Default Credentials ---
# Just run:  gcloud auth application-default login --scopes=https://www.googleapis.com/auth/spreadsheets,https://www.googleapis.com/auth/cloud-platform
# (no env vars needed; used as a fallback)

# ============================================================================
# Local paths + server
# ============================================================================
XLSX_PATH=./data/scouter.xlsx
STORE_PATH=./data/store.json
PORT=5178

# Public-hosting access gate: when set, the web UI requires HTTP Basic auth
# (any username, this password). REQUIRED if you expose the tool publicly,
# since it writes to your Google Sheet and stores scouted data.
# SCOUT_PASSWORD=
